// Include from config.kdl: include "../quickshell/keybinds/niri.kdl"
binds {
    Mod+Space { spawn "sh" "-c" "\"$HOME/.config/quickshell/natonctl\" ipc drawer toggle"; }
    Mod+Comma { spawn "sh" "-c" "\"$HOME/.config/quickshell/natonctl\" ipc settings toggle"; }
    Mod+V { spawn "sh" "-c" "\"$HOME/.config/quickshell/natonctl\" ipc clipboard toggle"; }
    Mod+N { spawn "sh" "-c" "\"$HOME/.config/quickshell/natonctl\" ipc notifications toggle"; }
    Mod+X { spawn "sh" "-c" "\"$HOME/.config/quickshell/natonctl\" ipc power toggle"; }
    Mod+C { spawn "sh" "-c" "\"$HOME/.config/quickshell/natonctl\" ipc control-center toggle"; }
    Mod+T { spawn "sh" "-c" "\"$HOME/.config/quickshell/natonctl\" ipc calendar toggle"; }
    Mod+M { spawn "sh" "-c" "\"$HOME/.config/quickshell/natonctl\" ipc media toggle"; }
    Mod+W { spawn "sh" "-c" "\"$HOME/.config/quickshell/natonctl\" ipc wifi toggle"; }
    Mod+B { spawn "sh" "-c" "\"$HOME/.config/quickshell/natonctl\" ipc bluetooth toggle"; }
    Mod+L { spawn "sh" "-c" "\"$HOME/.config/quickshell/natonctl\" ipc brightness toggle"; }
    Mod+K { spawn "sh" "-c" "\"$HOME/.config/quickshell/natonctl\" ipc keyboard toggle"; }
    Mod+I { spawn "sh" "-c" "\"$HOME/.config/quickshell/natonctl\" ipc system toggle"; }
}
